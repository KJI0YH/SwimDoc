<UserControl x:Class="UI.Views.Controls.DataGridView.AthletesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:dataView="clr-namespace:UI.Views.Controls.DataView"
             xmlns:toolbar="clr-namespace:UI.Views.Controls.Toolbar"
             xmlns:dataGridView="clr-namespace:UI.Views.Controls.DataGridView"
             xmlns:eventFilterComboBox="clr-namespace:UI.Views.Controls.EventFilterComboBox"
             xmlns:converters="clr-namespace:UI.Helpers.Converters"
             xmlns:loc="clr-namespace:UI.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullableIntConverter x:Key="NullableIntConverter" />
    </UserControl.Resources>
    <dataView:DefaultDataView>
        <dataView:DefaultDataView.Toolbar>
            <StackPanel>
                <WrapPanel Margin="0,0,0,4"
                           Visibility="{Binding IsFiltersPanelVisible, Converter={StaticResource BoolToVis}}">
                    <eventFilterComboBox:EventFilterComboBox
                        ItemsSource="{Binding AgeGroupFilterOptions}"
                        DisplayText="{Binding AgeGroupFilterText}"
                        ItemTemplate="{StaticResource EventFilterOptionTemplate}"
                        FilterWidth="{StaticResource SwimDocFilterAgeGroupWidth}"
                        Margin="5,0,5,5" />

                    <eventFilterComboBox:EventFilterComboBox
                        ItemsSource="{Binding GenderFilterOptions}"
                        DisplayText="{Binding GenderFilterText}"
                        ItemTemplate="{StaticResource EventFilterOptionTemplate}"
                        FilterWidth="{StaticResource SwimDocFilterGenderWidth}"
                        Margin="5,0,5,5" />

                    <StackPanel Orientation="Horizontal"
                                Margin="5,0,5,5"
                                VerticalAlignment="Center">
                        <ui:NumberBox
                            PlaceholderText="{loc:Localizastion Filters_BirthYearFrom}"
                            Value="{Binding BirthYearFrom, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableIntConverter}, TargetNullValue=''}"
                            Width="{StaticResource SwimDocFilterBirthYearWidth}"
                            Minimum="1900"
                            Margin="0,0,4,0" />
                        <ui:NumberBox
                            PlaceholderText="{loc:Localizastion Filters_BirthYearTo}"
                            Value="{Binding BirthYearTo, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableIntConverter}, TargetNullValue=''}"
                            Width="{StaticResource SwimDocFilterBirthYearWidth}"
                            Minimum="1900" />
                    </StackPanel>

                    <eventFilterComboBox:EventFilterComboBox
                        ItemsSource="{Binding CategoryFilterOptions}"
                        DisplayText="{Binding CategoryFilterText}"
                        ItemTemplate="{StaticResource EventFilterOptionTemplate}"
                        FilterWidth="{StaticResource SwimDocFilterCategoryWidth}"
                        Margin="5,0,5,5" />

                    <eventFilterComboBox:EventFilterComboBox
                        ItemsSource="{Binding ClubFilterOptions}"
                        DisplayText="{Binding ClubFilterText}"
                        ItemTemplate="{StaticResource EventFilterOptionTemplate}"
                        FilterWidth="{StaticResource SwimDocFilterClubWidth}"
                        Margin="5,0,5,5" />

                    <Button
                        Content="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{loc:Localizastion Filters_Clear}"
                        Command="{Binding ClearFiltersCommand}"
                        Margin="5,0,5,5"
                        Padding="9"
                        VerticalAlignment="Center" />
                </WrapPanel>

                <toolbar:AthletesToolbar />
            </StackPanel>
        </dataView:DefaultDataView.Toolbar>
        <dataView:DefaultDataView.MainContent>
            <dataGridView:DataGridView />
        </dataView:DefaultDataView.MainContent>
    </dataView:DefaultDataView>
</UserControl>
